# AEGIS environment template. Copy to .env and adjust. NEVER commit a real .env.
# Values below are development-only placeholders.

AEGIS_MODE=demo                      # demo | research | connected-production (shown in the UI)
AEGIS_ENVIRONMENT=development        # development | test | production
AEGIS_SECRET_KEY=dev-only-insecure-secret-change-me-0123456789   # production: 64+ random chars
AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis-dev-only@localhost:5432/aegis
AEGIS_REDIS_URL=redis://localhost:6379/0
AEGIS_TASK_MODE=celery               # celery | inline (inline = in-process thread, development only)
AEGIS_CORS_ORIGINS=http://localhost:3000   # comma-separated
AEGIS_COOKIE_SECURE=false            # production: true (HTTPS only)

# Evidence storage
AEGIS_STORAGE_BACKEND=local          # local | s3
AEGIS_STORAGE_ROOT=./var/evidence
# AEGIS_S3_BUCKET=aegis-evidence
# AEGIS_S3_ENDPOINT_URL=http://localhost:9000
# AEGIS_S3_OBJECT_LOCK=false
# AWS_ACCESS_KEY_ID=...  AWS_SECRET_ACCESS_KEY=...   (server-side only)

# Upload limits and scanning
AEGIS_MAX_UPLOAD_MB=512
AEGIS_MAX_TEXT_UPLOAD_MB=25
AEGIS_REQUIRE_MALWARE_SCAN=false     # production: true, with ClamAV configured
# AEGIS_CLAMAV_HOST=localhost
# AEGIS_CLAMAV_PORT=3310

# External processing kill switch (deployment-wide). Organisation and case must ALSO permit it.
AEGIS_ALLOW_EXTERNAL_PROCESSING=false

# --- Detection and verification methods (all optional) ---------------------------------------
# AEGIS reference text watermark (research verifier). Development-only demo key below; generate a new
# secret for any real deployment:  python -c "import secrets;print(secrets.token_urlsafe(32))"
AEGIS_REFERENCE_WATERMARK_KEY=dev-only-reference-watermark-key-0001
# C2PA trust anchors (PEM bundle). Without it, valid signatures are reported as "signer untrusted".
# AEGIS_C2PA_TRUST_ANCHORS=/etc/aegis/c2pa-trust-anchors.pem
# Local transformer detectors (requires: uv sync --extra transformers). Weights are not bundled.
# AEGIS_TEXT_CLASSIFIER_PATH=/models/text-classifier
# AEGIS_TEXT_CLASSIFIER_AI_LABEL=Fake
# AEGIS_SCORING_LM_PATH=/models/scoring-lm
# AEGIS_BINOCULARS_OBSERVER_PATH=/models/observer
# AEGIS_BINOCULARS_PERFORMER_PATH=/models/performer
# AEGIS_INFERENCE_DEVICE=cpu         # cpu | cuda
# Local ONNX media models (model.onnx + aegis_model.json)
# AEGIS_IMAGE_MODEL_DIR=/models/image
# AEGIS_SPEECH_MODEL_DIR=/models/speech
# External detection services (AEGIS provider contract; evidence leaves the deployment)
# AEGIS_PROVIDER_IMAGE_DETECTOR_URL=https://...
# AEGIS_PROVIDER_IMAGE_DETECTOR_TOKEN=...
# AEGIS_PROVIDER_AUDIO_DETECTOR_URL=https://...
# AEGIS_PROVIDER_VIDEO_DETECTOR_URL=https://...

# Demo seeding (development only)
AEGIS_DEMO_PASSWORD=Aegis-Demo-Only-2026

# Frontend
NEXT_PUBLIC_AEGIS_API_BASE=/api/v1
AEGIS_API_INTERNAL_URL=http://localhost:8000
